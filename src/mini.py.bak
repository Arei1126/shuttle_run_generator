import os
import numpy as np
import soundfile as sf
import math
from scipy.signal import resample_poly

SR = 44100
Note = {}
path_tone = "../material/tone/"
path_output = "output.wav"

Now = {"count": 0,
       "level": 0,
       "time": 0,
       }

def load_wav(path: str) -> np.ndarray:
    data, sr = sf.read(path)
    if data.ndim > 1:
        data = np.mean(data, axis=1)

# サンプリングレートが異なる場合のみリサンプリングを実行
    if sr != SR:
        # 例: sr=24000, target_sr=44100 の場合
        # 最大公約数（GCD=300）を求めて最小の整数比（up=147, down=80）を計算
        gcd = math.gcd(SR, sr)
        up = SR // gcd		# 44100 / 300 = 147
        down = sr // gcd		# 24000 / 300 = 80

        # ポリフェーズフィルタによる高品質リサンプリング
        data = resample_poly(data, up=up, down=down).astype(np.float32)

    return data.astype(np.float32)

def append_up(f, duration_sec, carry):
    tail = int(3*SR)
    chunk_data = np.zeros(int(duration_sec * SR) + tail, dtype=np.float32)
    bpm = duration_sec/9
    total_samples = int(duration_sec*SR + tail)

    up = ["c4", "d4", "e4", "f4", "g4", "a4", "b4", "c5"]
    for i, note in enumerate(up):
        start = int((i*bpm)*SR)
        end = int(((i+1)*bpm)*SR)
        use_len = min(end, total_samples) - start
        chunk_data[start:start+use_len] += Note[note][:use_len]

    chunk_data[int(bpm*8*SR):int(duration_sec*SR)] += Note["c3"][:int(bpm*SR)]
    chunk_data[int(bpm*8*SR):int(duration_sec*SR)] += Note["c4"][:int(bpm*SR)]

    f.write(chunk_data)
    pass

def main():
    carry = None
    notes =[ "c3", "c4", "d4", "e4", "f4", "g4", "a4", "b4", "c5", "d5", "g5", "c6", "d6"] 
    for note in notes:
        Note[note] = load_wav(f"{path_tone}{note}.wav")
   
    with sf.SoundFile(path_output, mode="w", samplerate=SR, channels=1, subtype="PCM_16") as f:
        append_up(f,  9, carry) 


if __name__ == "__main__":
    main()
